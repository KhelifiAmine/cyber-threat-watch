# ============================================================================
# CyberShield — Environment configuration TEMPLATE
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Generate strong secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

# ─── Environment ───
# development | production   (production disables docs, enables HSTS, blocks
# weak SECRET_KEY at startup, and does NOT seed default test accounts)
ENVIRONMENT=production
DEBUG=false

# ─── Database (PostgreSQL) ───
DB_USER=cybershield
DB_PASSWORD=__CHANGE_ME__strong_db_password__
DB_NAME=cybershield
# Used by the app directly (must match the values above):
# DATABASE_URL=postgresql+asyncpg://cybershield:__CHANGE_ME__@postgres:5432/cybershield

# ─── Redis (broker + cache + rate-limiter) ───
REDIS_PASSWORD=__CHANGE_ME__strong_redis_password__
REDIS_URL=redis://:__CHANGE_ME__strong_redis_password__@redis:6379/0

# ─── Auth / JWT ───
# MUST be a long random value. Startup FAILS in production if this is empty
# or a known placeholder.
SECRET_KEY=__CHANGE_ME__run_secrets.token_urlsafe(48)__

# ─── Initial admin bootstrap (production only) ───
# If set, a single admin is created on first startup. Otherwise create the
# first admin with: python scripts/create_admin.py <email> <password>
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ─── Email / SMTP ───
# Point this at your own SMTP relay / transactional-email service.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_ENABLED=true
SMTP_FROM_EMAIL=alerts@example.com
SMTP_FROM_NAME=Cyber Threat Watch

# ─── External services ───
NVD_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434
